// Prisma schema — turunan dari docs/ERD.md
// Jalankan `pnpm prisma migrate dev` setelah DATABASE_URL di .env terisi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  CUSTOMER
  SUPER_ADMIN
  STAFF_GUDANG
  CS
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PreorderPaymentType {
  FULL
  DOWN_PAYMENT
}

enum VariantType {
  TEXT
  COLOR
}

enum OrderType {
  REGULAR
  PRE_ORDER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  WAITING_STOCK
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  VA
  QRIS
  EWALLET
  INVOICE
  MANUAL_TRANSFER
}

enum PaymentChannelType {
  BANK_TRANSFER
  QRIS_STATIC
}

enum PaymentStage {
  FULL
  DOWN_PAYMENT
  FINAL_PAYMENT
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  CONFIRMED
  ALLOCATED
  PICKED_UP
  ON_PROCESS
  DELIVERED
  CANCELLED
  RETURNED
}

enum VoucherType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  NEW_ORDER
  ORDER_CANCELLED
  STOCK_LOW
  PAYMENT_PROOF_SUBMITTED
}

// ---------- Core: User & Address ----------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  cart          Cart?
  notifications Notification[]
  warehouses    WarehouseStaff[]

  @@map("users")
}

model Address {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String
  recipientName  String
  phone          String
  province       String
  city           String
  district       String
  postalCode     String
  fullAddress    String   @db.Text
  biteshipAreaId String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  orders Order[]

  @@map("addresses")
}

// ---------- Warehouse (multi-gudang) ----------

model Warehouse {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  phone          String
  province       String
  city           String
  district       String
  postalCode     String
  fullAddress    String   @db.Text
  biteshipAreaId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  staff         WarehouseStaff[]
  stocks        WarehouseStock[]
  products      Product[]
  orders        Order[]
  shipments     Shipment[]
  notifications Notification[]

  @@map("warehouses")
}

model WarehouseStaff {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([warehouseId, userId])
  @@map("warehouse_staff")
}

model WarehouseStock {
  id               String         @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  stock            Int            @default(0)

  @@unique([warehouseId, productVariantId])
  @@map("warehouse_stocks")
}

// ---------- Catalog ----------

model Category {
  id       String     @id @default(uuid())
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  name     String
  slug     String     @unique

  products Product[]

  @@map("categories")
}

model Product {
  id                    String               @id @default(uuid())
  categoryId            String
  category              Category             @relation(fields: [categoryId], references: [id])
  warehouseId           String?
  warehouse             Warehouse?           @relation(fields: [warehouseId], references: [id])
  name                  String
  slug                  String               @unique
  description           String               @db.Text
  basePrice             Decimal              @db.Decimal(12, 2)
  compareAtPrice        Decimal?             @db.Decimal(12, 2)
  discountStartDate     DateTime?
  discountEndDate       DateTime?
  weightGrams           Decimal              @db.Decimal(10, 2)
  lengthCm              Decimal              @db.Decimal(10, 2)
  widthCm               Decimal              @db.Decimal(10, 2)
  heightCm              Decimal              @db.Decimal(10, 2)
  status                ProductStatus        @default(DRAFT)
  isPreorder            Boolean              @default(false)
  preorderPaymentType   PreorderPaymentType?
  preorderDpPercentage  Decimal?             @db.Decimal(5, 2)
  preorderEstimatedDate DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  variants ProductVariant[]
  images   ProductImage[]
  specs    ProductSpec[]
  reviews  Review[]

  @@map("products")
}

model ProductSpec {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sortOrder Int     @default(0)

  @@map("product_specs")
}

model ProductVariant {
  id        String      @id @default(uuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String      @unique
  name      String
  type      VariantType @default(TEXT)
  colorHex  String?
  price     Decimal     @db.Decimal(12, 2)
  stock     Int         @default(0)

  cartItems       CartItem[]
  orderItems      OrderItem[]
  warehouseStocks WarehouseStock[]

  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@map("product_images")
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("reviews")
}

// ---------- Cart ----------

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id               String         @id @default(uuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  quantity         Int            @default(1)

  @@unique([cartId, productVariantId])
  @@map("cart_items")
}

// ---------- Voucher ----------

model Voucher {
  id          String      @id @default(uuid())
  code        String      @unique
  type        VoucherType
  value       Decimal     @db.Decimal(12, 2)
  minPurchase Decimal     @default(0) @db.Decimal(12, 2)
  quota       Int
  startDate   DateTime
  endDate     DateTime

  orders Order[]

  @@map("vouchers")
}

// ---------- Order ----------

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  addressId      String
  address        Address     @relation(fields: [addressId], references: [id])
  voucherId      String?
  voucher        Voucher?    @relation(fields: [voucherId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?  @relation(fields: [warehouseId], references: [id])
  orderType      OrderType   @default(REGULAR)
  subtotal       Decimal     @db.Decimal(12, 2)
  shippingCost   Decimal     @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  status         OrderStatus @default(PENDING_PAYMENT)
  courierCode    String?
  courierService String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items         OrderItem[]
  payments      Payment[]
  shipment      Shipment?
  statusHistory OrderStatusHistory[]
  notifications Notification[]

  @@map("orders")
}

model OrderItem {
  id                  String         @id @default(uuid())
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId    String
  productVariant      ProductVariant @relation(fields: [productVariantId], references: [id])
  productNameSnapshot String
  priceSnapshot       Decimal        @db.Decimal(12, 2)
  quantity            Int

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?     @db.Text
  createdAt DateTime    @default(now())

  @@map("order_status_histories")
}

// ---------- Payment (Xendit) ----------

model Payment {
  id               String          @id @default(uuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  xenditId         String?         @unique
  method           PaymentMethod
  channel          String?
  paymentChannelId String?
  paymentChannel   PaymentChannel? @relation(fields: [paymentChannelId], references: [id])
  proofUrl         String?
  stage            PaymentStage    @default(FULL)
  amount           Decimal         @db.Decimal(12, 2)
  status           PaymentStatus   @default(PENDING)
  paymentUrl       String?
  expiredAt        DateTime?
  paidAt           DateTime?
  createdAt        DateTime        @default(now())

  logs PaymentLog[]

  @@map("payments")
}

// Master data rekening bank / QRIS statis untuk pembayaran manual
// (dikelola Super Admin di /admin/settings — lihat docs/MEMORY.md §8.11)
model PaymentChannel {
  id            String             @id @default(uuid())
  type          PaymentChannelType
  label         String
  bankName      String?
  accountNumber String?
  accountHolder String?
  qrisImageUrl  String?
  instructions  String?            @db.Text
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  payments Payment[]

  @@map("payment_channels")
}

model PaymentLog {
  id         String   @id @default(uuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType  String
  rawPayload Json
  createdAt  DateTime @default(now())

  @@map("payment_logs")
}

// ---------- Shipment (Biteship) ----------

model Shipment {
  id              String         @id @default(uuid())
  orderId         String         @unique
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId     String?
  warehouse       Warehouse?     @relation(fields: [warehouseId], references: [id])
  biteshipOrderId String?        @unique
  courierCode     String
  courierService  String
  waybillNumber   String?
  trackingUrl     String?
  status          ShipmentStatus @default(CONFIRMED)
  createdAt       DateTime       @default(now())

  tracking ShipmentTracking[]

  @@map("shipments")
}

model ShipmentTracking {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  description String?  @db.Text
  eventTime   DateTime

  @@map("shipment_trackings")
}

// ---------- Notification (dashboard gudang) ----------

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId String?
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id])
  type        NotificationType
  title       String
  message     String           @db.Text
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@map("notifications")
}

// ---------- Banner (hero storefront) ----------

model Banner {
  id        String   @id @default(uuid())
  badgeText String?
  title     String
  subtitle  String?
  imageUrl  String
  ctaLabel  String?
  ctaLink   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

// ---------- Store Settings (singleton row, id selalu "singleton") ----------

model StoreSettings {
  id          String   @id @default("singleton")
  name        String   @default("Pratama Jaya")
  email       String   @default("info@pratamajaya.com")
  description String   @db.Text
  phone       String   @default("+62 812-3456-7890")
  whatsapp    String   @default("+62 812-3456-7890")
  updatedAt   DateTime @updatedAt

  @@map("store_settings")
}
